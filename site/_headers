# Cloudflare Pages headers. https://developers.cloudflare.com/pages/configuration/headers/
# frame-src: only the arcade's game frames (/arcade/, assets/js/arcade.js), all on the owner's workers.dev
# subdomain. frame-ancestors 'none' + X-Frame-Options DENY still keep this site itself out of anyone's frames.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; frame-src https://*.dillon-eu-green.workers.dev; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/assets/img/*
  Cache-Control: public, max-age=2592000

# gameplay loops for the game cards (tools/capture_clips.js); <video> falls under default-src 'self'
/assets/clips/*
  Cache-Control: public, max-age=2592000

# per-page share cards (tools/render_og.js)
/assets/og/*
  Cache-Control: public, max-age=604800

/assets/css/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/js/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*.png
  Cache-Control: public, max-age=604800

/favicon.*
  Cache-Control: public, max-age=604800

/Dillon_Green_Resume.pdf
  Cache-Control: public, max-age=0, must-revalidate
  Content-Disposition: inline; filename="Dillon_Green_Resume.pdf"

# owner-only admin pages: never indexed, never cached
/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
